<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2024.1.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AccessibleZoneTabOrder />
    <AnimationOnByDefault />
    <MarkAnimation />
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='student_mental_health_cleaned' inline='true' name='federated.main_data' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='student_mental_health_cleaned' name='textscan.main'>
            <connection class='textscan' directory='.' filename='student_mental_health_cleaned.csv' />
          </named-connection>
        </named-connections>
      </connection>
      <aliases enabled='yes' />
      <column caption='Age' datatype='integer' name='[Age]' role='measure' type='quantitative' />
      <column caption='Anxiety' datatype='string' name='[Anxiety]' role='dimension' type='nominal' />
      <column caption='CGPA Midpoint' datatype='real' name='[CGPA_Midpoint]' role='measure' type='quantitative' />
      <column caption='CGPA Range' datatype='string' name='[CGPA_Range]' role='dimension' type='ordinal' />
      <column caption='Condition Count' datatype='integer' name='[Condition_Count]' role='measure' type='quantitative' />
      <column caption='Course' datatype='string' name='[Course]' role='dimension' type='nominal' />
      <column caption='Depression' datatype='string' name='[Depression]' role='dimension' type='nominal' />
      <column caption='Faculty' datatype='string' name='[Faculty]' role='dimension' type='nominal' />
      <column caption='Gender' datatype='string' name='[Gender]' role='dimension' type='nominal' />
      <column caption='Panic Attacks' datatype='string' name='[Panic_Attacks]' role='dimension' type='nominal' />
      <column caption='Risk Category' datatype='string' name='[Risk_Category]' role='dimension' type='nominal' />
      <column caption='Sought Treatment' datatype='string' name='[Sought_Treatment]' role='dimension' type='nominal' />
      <column caption='Treatment Status' datatype='string' name='[Treatment_Status]' role='dimension' type='nominal' />
      <column caption='Year of Study' datatype='string' name='[Year_of_Study]' role='dimension' type='ordinal' />
      
      <!-- Calculated Fields -->
      <column caption='Composite Stress Index' datatype='real' name='[Calculation_Stress_Index]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Condition_Count] / 3.0) * 100.0' />
      </column>
      <column caption='High Risk Indicator' datatype='integer' name='[Calculation_High_Risk_Flag]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Risk_Category] = "High Risk" THEN 1 ELSE 0 END' />
      </column>
      <column caption='Treatment Seeking Flag' datatype='integer' name='[Calculation_Treatment_Flag]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sought_Treatment] = "Yes" THEN 1 ELSE 0 END' />
      </column>
      <column caption='Depression Indicator' datatype='integer' name='[Calculation_Depression_Flag]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Depression] = "Yes" THEN 1 ELSE 0 END' />
      </column>
      <column caption='Anxiety Indicator' datatype='integer' name='[Calculation_Anxiety_Flag]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Anxiety] = "Yes" THEN 1 ELSE 0 END' />
      </column>
      <column caption='Panic Attack Indicator' datatype='integer' name='[Calculation_Panic_Flag]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Panic_Attacks] = "Yes" THEN 1 ELSE 0 END' />
      </column>
      <column caption='High Risk Treatment Gap' datatype='string' name='[Calculation_Treatment_Gap]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Risk_Category] = "High Risk" AND [Sought_Treatment] = "No" THEN "High Risk Untreated" ELSEIF [Risk_Category] = "High Risk" AND [Sought_Treatment] = "Yes" THEN "High Risk in Treatment" ELSE "Moderate/Low Risk" END' />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <!-- Worksheet 1: Gender vs Mental Health Prevalence -->
    <worksheet name='Gender vs Mental Health'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[Gender]' role='dimension' type='nominal' />
            <column name='[Depression]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.main_data].[none:Gender:nk]</rows>
        <cols>[federated.main_data].[none:Depression:nk]</cols>
      </table>
    </worksheet>

    <!-- Worksheet 2: Age & Study Year Demographics -->
    <worksheet name='Age and Study Year Distribution'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[Age]' role='measure' type='quantitative' />
            <column name='[Year_of_Study]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.main_data].[none:Year_of_Study:ok]</rows>
        <cols>[federated.main_data].[none:Age:qk]</cols>
      </table>
    </worksheet>

    <!-- Worksheet 3: CGPA vs Depression & Anxiety -->
    <worksheet name='CGPA vs Depression and Anxiety'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[CGPA_Range]' role='dimension' type='ordinal' />
            <column name='[Calculation_Depression_Flag]' role='measure' type='quantitative' />
            <column name='[Calculation_Anxiety_Flag]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.main_data].[none:CGPA_Range:ok]</rows>
        <cols>[federated.main_data].[sum:Calculation_Depression_Flag:qk]</cols>
      </table>
    </worksheet>

    <!-- Worksheet 4: Condition Co-occurrence & Risk Breakdown -->
    <worksheet name='Condition Breakdown'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[Risk_Category]' role='dimension' type='nominal' />
            <column name='[Condition_Count]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
          </pane>
        </panes>
        <rows>[federated.main_data].[none:Risk_Category:nk]</rows>
        <cols>[federated.main_data].[sum:Condition_Count:qk]</cols>
      </table>
    </worksheet>

    <!-- Worksheet 5: Faculty & Course Stress Comparison -->
    <worksheet name='Faculty Stress Comparison'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[Faculty]' role='dimension' type='nominal' />
            <column name='[Calculation_High_Risk_Flag]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.main_data].[none:Faculty:nk]</rows>
        <cols>[federated.main_data].[sum:Calculation_High_Risk_Flag:qk]</cols>
      </table>
    </worksheet>

    <!-- Worksheet 6: Overall Risk Segmentation (Donut/Pie) -->
    <worksheet name='Overall Risk Segmentation'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[Risk_Category]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Pie' />
          </pane>
        </panes>
        <rows />
        <cols>[federated.main_data].[none:Risk_Category:nk]</cols>
      </table>
    </worksheet>

    <!-- Worksheet 7: Year of Study Risk Heatmap -->
    <worksheet name='Year of Study Risk Heatmap'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[Year_of_Study]' role='dimension' type='ordinal' />
            <column name='[Risk_Category]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
          </pane>
        </panes>
        <rows>[federated.main_data].[none:Year_of_Study:ok]</rows>
        <cols>[federated.main_data].[none:Risk_Category:nk]</cols>
      </table>
    </worksheet>

    <!-- Worksheet 8: Faculty Discipline Breakdown (Treemap) -->
    <worksheet name='Discipline Treemap'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[Faculty]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
          </pane>
        </panes>
        <rows />
        <cols>[federated.main_data].[none:Faculty:nk]</cols>
      </table>
    </worksheet>

    <!-- Worksheet 9: Academic Workload vs Anxiety Trend -->
    <worksheet name='Academic Performance vs Anxiety Trend'>
      <table>
        <view>
          <datasources>
            <datasource name='federated.main_data' />
          </datasources>
          <datasource-dependencies datasource='federated.main_data'>
            <column name='[CGPA_Midpoint]' role='measure' type='quantitative' />
            <column name='[Calculation_Stress_Index]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.main_data].[avg:Calculation_Stress_Index:qk]</rows>
        <cols>[federated.main_data].[none:CGPA_Midpoint:qk]</cols>
      </table>
    </worksheet>
  </worksheets>

  <!-- Dashboards -->
  <dashboards>
    <dashboard name='Dashboard1_Demographics'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' type='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='50000' id='2' name='Gender vs Mental Health' w='50000' x='0' y='0' />
          <zone h='50000' id='3' name='Age and Study Year Distribution' w='50000' x='50000' y='0' />
          <zone h='50000' id='4' name='Discipline Treemap' w='50000' x='0' y='50000' />
          <zone h='50000' id='5' name='CGPA vs Depression and Anxiety' w='50000' x='50000' y='50000' />
        </zone>
      </zones>
    </dashboard>
    
    <dashboard name='Dashboard2_Risk_Diagnostics'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' type='fixed' />
      <zones>
        <zone h='100000' id='10' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='50000' id='11' name='Overall Risk Segmentation' w='50000' x='0' y='0' />
          <zone h='50000' id='12' name='Year of Study Risk Heatmap' w='50000' x='50000' y='0' />
          <zone h='50000' id='13' name='Faculty Stress Comparison' w='50000' x='0' y='50000' />
          <zone h='50000' id='14' name='Academic Performance vs Anxiety Trend' w='50000' x='50000' y='50000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>

  <!-- Windows & Story -->
  <windows>
    <window class='dashboard' name='Dashboard1_Demographics'>
      <viewpoints />
      <active id='2' />
    </window>
    <window class='dashboard' name='Dashboard2_Risk_Diagnostics'>
      <viewpoints />
      <active id='11' />
    </window>
    <window class='worksheet' name='Gender vs Mental Health'>
      <cards />
    </window>
    <window class='worksheet' name='Age and Study Year Distribution'>
      <cards />
    </window>
    <window class='worksheet' name='CGPA vs Depression and Anxiety'>
      <cards />
    </window>
    <window class='worksheet' name='Condition Breakdown'>
      <cards />
    </window>
    <window class='worksheet' name='Faculty Stress Comparison'>
      <cards />
    </window>
    <window class='worksheet' name='Overall Risk Segmentation'>
      <cards />
    </window>
    <window class='worksheet' name='Year of Study Risk Heatmap'>
      <cards />
    </window>
    <window class='worksheet' name='Discipline Treemap'>
      <cards />
    </window>
    <window class='worksheet' name='Academic Performance vs Anxiety Trend'>
      <cards />
    </window>
  </windows>
</workbook>
